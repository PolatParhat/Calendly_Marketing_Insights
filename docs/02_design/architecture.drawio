<mxfile host="drawio">
  <diagram id="arch" name="Architecture">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Calendly Marketing Insights: AWS architecture (Lambda architecture, option A: Delta Lake + Amazon EMR)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1200" height="40" as="geometry" />
        </mxCell>

        <!-- ===== Section containers (match the 5 sections of the given diagram) ===== -->
        <mxCell id="sec1" value="1. SOURCES" style="rounded=1;arcSize=4;dashed=1;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="230" height="560" as="geometry" />
        </mxCell>
        <mxCell id="sec2" value="2. WEBHOOK + INGESTION" style="rounded=1;arcSize=4;dashed=1;fillColor=#FDF2F8;strokeColor=#E7157B;verticalAlign=top;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="60" width="380" height="560" as="geometry" />
        </mxCell>
        <mxCell id="sec3" value="3. DELTA LAKE + AMAZON EMR (storage + processing)" style="rounded=1;arcSize=4;dashed=1;fillColor=#F3EEFF;strokeColor=#8C4FFF;verticalAlign=top;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1">
          <mxGeometry x="670" y="60" width="430" height="560" as="geometry" />
        </mxCell>
        <mxCell id="sec4" value="4. DATA WAREHOUSE" style="rounded=1;arcSize=4;dashed=1;fillColor=#EEF6FF;strokeColor=#1E6FD9;verticalAlign=top;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1">
          <mxGeometry x="1120" y="60" width="240" height="560" as="geometry" />
        </mxCell>
        <mxCell id="sec5" value="5. VISUALISATION" style="rounded=1;arcSize=4;dashed=1;fillColor=#FFF1F0;strokeColor=#FF4B4B;verticalAlign=top;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1">
          <mxGeometry x="1380" y="60" width="240" height="560" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="read key" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;fontSize=11;labelBackgroundColor=#FDF2F8;exitX=0;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="whlambda" target="secrets">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="325" y="250" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" value="on failure" style="html=1;endArrow=block;dashed=1;fontSize=11;labelBackgroundColor=#FDF2F8;" edge="1" parent="1" source="whlambda" target="dlq">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== 1. Sources ===== -->
        <mxCell id="calendly" value="&lt;b&gt;Calendly&lt;/b&gt;&lt;br&gt;webhook event&lt;br&gt;&lt;i&gt;invitee.created&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#006BFF;fontColor=#FFFFFF;strokeColor=none;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="55" y="120" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="spendsrc" value="&lt;b&gt;Marketing spend&lt;/b&gt;&lt;br&gt;public S3 JSON files&lt;br&gt;file_index.json&lt;br&gt;(Day-1, 06:00 AM EST, USD)" style="outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1">
          <mxGeometry x="105" y="410" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- ===== 2. Webhook + ingestion ===== -->
        <mxCell id="apigw" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;HTTP API&lt;br&gt;POST /webhook" style="outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1">
          <mxGeometry x="300" y="125" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="whlambda" value="&lt;b&gt;Lambda&lt;/b&gt;&lt;br&gt;webhook receiver" style="labelBackgroundColor=#FDF2F8;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="430" y="125" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="secrets" value="&lt;b&gt;Secrets Manager&lt;/b&gt;&lt;br&gt;signing key&lt;br&gt;(signature check)" style="outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" vertex="1" parent="1">
          <mxGeometry x="300" y="290" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="dlq" value="&lt;b&gt;SQS&lt;/b&gt;&lt;br&gt;dead-letter queue&lt;br&gt;(failed events)" style="outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1">
          <mxGeometry x="435" y="290" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="landing" value="&lt;b&gt;S3 landing/&lt;/b&gt;&lt;br&gt;raw JSON&lt;br&gt;calendly/ + spend/" style="outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1">
          <mxGeometry x="565" y="270" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="spendlambda" value="&lt;b&gt;Lambda&lt;/b&gt;&lt;br&gt;spend ingestion&lt;br&gt;copies every file&lt;br&gt;in file_index.json" style="outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="430" y="410" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- ===== 3. Delta Lake + EMR ===== -->
        <mxCell id="emr" value="&lt;b&gt;EMR Serverless&lt;/b&gt;&lt;br&gt;one PySpark job, daily&lt;br&gt;Delta MERGE (no duplicates)" style="outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;align=left;spacingLeft=6;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.emr;" vertex="1" parent="1">
          <mxGeometry x="760" y="120" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lake" value="Delta Lake on S3 (SSE-KMS encrypted)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00ADD4;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#00838F;" vertex="1" parent="1">
          <mxGeometry x="685" y="270" width="400" height="320" as="geometry" />
        </mxCell>
        <mxCell id="bronze" value="&lt;b&gt;BRONZE&lt;/b&gt;&lt;br&gt;&lt;br&gt;raw rows, all events,&lt;br&gt;nothing dropped&lt;br&gt;&lt;br&gt;bookings_raw&lt;br&gt;spend_raw" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8C9A5;strokeColor=#A0522D;fontSize=12;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="697" y="310" width="118" height="200" as="geometry" />
        </mxCell>
        <mxCell id="silver" value="&lt;b&gt;SILVER&lt;/b&gt;&lt;br&gt;&lt;br&gt;flattened, typed,&lt;br&gt;de-duplicated,&lt;br&gt;3 marketing channels&lt;br&gt;&lt;br&gt;bookings&lt;br&gt;booking_hosts&lt;br&gt;spend_daily" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3E3E3;strokeColor=#808080;fontSize=12;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="826" y="310" width="118" height="200" as="geometry" />
        </mxCell>
        <mxCell id="gold" value="&lt;b&gt;GOLD&lt;/b&gt;&lt;br&gt;&lt;br&gt;business tables&lt;br&gt;for the 6 metrics&lt;br&gt;&lt;br&gt;daily_bookings&lt;br&gt;cpb_by_channel&lt;br&gt;bookings_by_hour&lt;br&gt;meeting_load&lt;br&gt;..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE599;strokeColor=#BF9000;fontSize=12;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="955" y="310" width="118" height="200" as="geometry" />
        </mxCell>
        <mxCell id="lakenote" value="Delta = ACID writes, MERGE, time travel" style="text;html=1;align=center;fontSize=11;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="695" y="530" width="380" height="30" as="geometry" />
        </mxCell>

        <!-- ===== 4. Data warehouse ===== -->
        <mxCell id="glue" value="&lt;b&gt;Glue Data Catalog&lt;/b&gt;&lt;br&gt;table definitions&lt;br&gt;for the Gold tables" style="outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.glue;" vertex="1" parent="1">
          <mxGeometry x="1210" y="380" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="athena" value="&lt;b&gt;Amazon Athena&lt;/b&gt;&lt;br&gt;SQL over Gold&lt;br&gt;(pay per query)" style="outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.athena;" vertex="1" parent="1">
          <mxGeometry x="1210" y="160" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- ===== 5. Visualisation ===== -->
        <mxCell id="streamlit" value="&lt;b&gt;Streamlit dashboard&lt;/b&gt;&lt;br&gt;&lt;br&gt;1.1 Daily calls by source&lt;br&gt;1.2 Cost per booking&lt;br&gt;1.3 Bookings trend&lt;br&gt;1.4 Channel attribution&lt;br&gt;1.5 Volume by hour / weekday&lt;br&gt;1.6 Meeting load" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF4B4B;fontColor=#FFFFFF;strokeColor=none;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1400" y="120" width="200" height="170" as="geometry" />
        </mxCell>

        <!-- ===== Data-flow arrows (solid) ===== -->
        <mxCell id="e1" value="HTTPS POST" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="calendly" target="apigw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="apigw" target="whlambda">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;entryX=0;entryY=0.33;entryDx=0;entryDy=0;" edge="1" parent="1" source="whlambda" target="landing">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="530" y="155" /><mxPoint x="530" y="290" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e6" value="HTTPS GET" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="spendsrc" target="spendlambda">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FDF2F8;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="spendlambda" target="landing">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="530" y="440" /><mxPoint x="530" y="318" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e8" value="read" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="landing" target="emr">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="595" y="150" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e9" value="writes Bronze, Silver, Gold" style="html=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#F3EEFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.26;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="emr" target="lake">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="790" y="230" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e10" style="html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="bronze" target="silver">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="silver" target="gold">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="register tables" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="gold" target="glue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="table&lt;br&gt;schema" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#EEF6FF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="glue" target="athena">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1160" y="410" /><mxPoint x="1160" y="190" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e14" value="SQL queries" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="athena" target="streamlit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== Cross-cutting band: scheduling, failure reload, security, CI/CD ===== -->
        <mxCell id="band" value="RUNS ACROSS ALL SECTIONS" style="rounded=1;arcSize=3;dashed=1;fillColor=#FAFAFA;strokeColor=#7A9E3B;verticalAlign=top;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="640" width="1600" height="340" as="geometry" />
        </mxCell>

        <!-- Scheduling -->
        <mxCell id="bx_sched" value="SCHEDULING" style="rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#E7157B;verticalAlign=top;fontStyle=1;fontSize=13;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="520" height="280" as="geometry" />
        </mxCell>
        <mxCell id="eb" value="&lt;b&gt;EventBridge Scheduler&lt;/b&gt;&lt;br&gt;daily 07:00 US Eastern&lt;br&gt;(after spend file at 06:00)" style="outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;" vertex="1" parent="1">
          <mxGeometry x="90" y="730" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sfn" value="&lt;b&gt;Step Functions&lt;/b&gt;&lt;br&gt;daily workflow" style="outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.step_functions;" vertex="1" parent="1">
          <mxGeometry x="270" y="730" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sfnsteps" value="&lt;b&gt;Daily workflow:&lt;/b&gt;&lt;br&gt;1. run spend Lambda&lt;br&gt;2. run EMR Serverless job&lt;br&gt;3. each step: retry 2x,&lt;br&gt;&amp;nbsp; &amp;nbsp; then alert" style="text;html=1;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="840" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e15" value="start" style="html=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="eb" target="sfn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sfnnote" value="Webhook path is real time (event-driven), no schedule needed. Batch path (spend + Spark job) runs once a day." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="320" y="850" width="230" height="80" as="geometry" />
        </mxCell>

        <!-- Failure reload -->
        <mxCell id="bx_fail" value="FAILURE RELOAD + ALERTS" style="rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#ED7100;verticalAlign=top;fontStyle=1;fontSize=13;html=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="680" width="340" height="280" as="geometry" />
        </mxCell>
        <mxCell id="sns" value="&lt;b&gt;SNS&lt;/b&gt;&lt;br&gt;email alert on failure" style="outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;" vertex="1" parent="1">
          <mxGeometry x="720" y="730" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="failtext" value="• Step Functions retries each step&lt;br&gt;• Failed webhook events kept in SQS DLQ,&lt;br&gt;&amp;nbsp; replayed later&lt;br&gt;• Spend Lambda re-copies all 30 files:&lt;br&gt;&amp;nbsp; a missed day fills itself in&lt;br&gt;• Delta MERGE: re-running = no duplicates" style="text;html=1;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="595" y="825" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e16" value="on failure" style="html=1;endArrow=block;dashed=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sfn" target="sns">
          <mxGeometry relative="1" as="geometry">
            
          </mxGeometry>
        </mxCell>

        <!-- Security -->
        <mxCell id="bx_sec" value="SECURITY + ENCRYPTION" style="rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#DD344C;verticalAlign=top;fontStyle=1;fontSize=13;html=1;" vertex="1" parent="1">
          <mxGeometry x="940" y="680" width="340" height="280" as="geometry" />
        </mxCell>
        <mxCell id="kms" value="&lt;b&gt;KMS&lt;/b&gt;&lt;br&gt;encryption key" style="outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="1">
          <mxGeometry x="990" y="720" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="iam" value="&lt;b&gt;IAM&lt;/b&gt;&lt;br&gt;least-privilege roles" style="outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;" vertex="1" parent="1">
          <mxGeometry x="1150" y="720" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sectext" value="• All S3 data encrypted at rest (SSE-KMS)&lt;br&gt;• HTTPS only in transit&lt;br&gt;• Webhook signature checked on every call&lt;br&gt;• Signing key in Secrets Manager, not code&lt;br&gt;• Data has PII (names, emails, phones)" style="text;html=1;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="955" y="825" width="320" height="110" as="geometry" />
        </mxCell>

        <!-- CI/CD -->
        <mxCell id="bx_cicd" value="CI/CD + INFRASTRUCTURE AS CODE" style="rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#24292F;verticalAlign=top;fontStyle=1;fontSize=13;html=1;" vertex="1" parent="1">
          <mxGeometry x="1300" y="680" width="300" height="280" as="geometry" />
        </mxCell>
        <mxCell id="github" value="&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;tests + lint + cdk synth&lt;br&gt;on every pull request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24292F;fontColor=#FFFFFF;strokeColor=none;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1350" y="720" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cdk" value="&lt;b&gt;AWS CDK (Python)&lt;/b&gt;&lt;br&gt;all resources above&lt;br&gt;defined as code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF9900;fontColor=#232F3E;strokeColor=none;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1350" y="830" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e17" value="deploy" style="html=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="github" target="cdk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
